# CODEOWNERS - ownership per directory
#
# NOTE: the teams below are PLACEHOLDERS and still have to be filled in with the
# real team or user names of our organization. As long as that has not happened,
# automatic reviewer assignment does not work.
#
# Format: <path> <owner(s)>, for example @your-org/backend-team or @username.
# A team has to have write access to this repo, otherwise GitHub ignores the rule.
# The last matching rule wins, so specific paths at the bottom.

# Fallback: everything without a specific owner
*                   @your-org/tech-leads

# Stack-independent conventions - they affect everyone, so review broadly
/general/           @your-org/tech-leads

# .NET
/dotnet/            @your-org/backend-team

# React
/react/             @your-org/frontend-team

# Skills - the relevant owner per stack
/skills/            @your-org/tech-leads
/skills/dotnet-feature/    @your-org/backend-team
/skills/react-component/   @your-org/frontend-team

# Ops - database, containers, CI/CD. Touches production, so review broadly.
/ops/               @your-org/tech-leads

# Templates - changes here affect every project that copies them
/templates/         @your-org/tech-leads
